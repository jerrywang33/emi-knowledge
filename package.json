{
  "name": "emi-knowledge",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run validate",
    "example:query": "tsx examples/consumer/query-release.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "validate": "npm run validate:knowledge && npm run validate:topics",
    "validate:knowledge": "tsx src/cli.ts validate knowledge/v0.1 schemas/v0.1/knowledge-object.schema.json --allow-incomplete",
    "validate:topics": "tsx src/cli.ts validate-topics knowledge/topics schemas/v0.1/topic-manifest.schema.json knowledge/v0.1 schemas/v0.1/knowledge-object.schema.json",
    "release:v0.1": "tsx src/cli.ts release releases/v0.1.0/release.config.json",
    "release:v0.2": "tsx src/cli.ts release releases/v0.2.0/release.config.json",
    "release:v0.3": "tsx src/cli.ts release releases/v0.3.0/release.config.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
